    "express-validator": "^7.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.1",
    "nodemailer": "^10.0.8",
    "pdfkit": "^0.20.2",
    "pg": "^8.16.3"
  },
