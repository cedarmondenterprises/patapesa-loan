DOMAIN=loans.example.com
ADMIN_DOMAIN=admin.loans.example.com
DB_USER=patapesa
DB_PASSWORD=generate_a_long_random_database_password
DB_NAME=patapesa_db
JWT_SECRET=generate_at_least_32_random_characters
JWT_EXPIRATION=7d
SESSION_MAX_AGE_HOURS=168
KYC_ENCRYPTION_KEY=generate_a_separate_long_random_key

# Required for registration OTP, login OTP and password recovery. Gmail is free for low-volume use.
# Use a Google app password, never the mailbox's normal password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-gmail-address@gmail.com
SMTP_PASSWORD=replace_with_smtp_password
EMAIL_FROM="PataPesa <your-gmail-address@gmail.com>"

# Required only when enabling docker-compose.observability.yml.
GRAFANA_ADMIN_USER=patapesa_admin
GRAFANA_ADMIN_PASSWORD=generate_a_separate_long_random_password
GRAFANA_PORT=3100
UPTIME_KUMA_PORT=3002
