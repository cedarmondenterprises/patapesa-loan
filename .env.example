NODE_ENV=development

# Backend
APP_PORT=5000
DATABASE_URL=postgresql://patapesa:replace_with_a_strong_password@postgres:5432/patapesa_db
DB_SSL=false
JWT_SECRET=replace_with_at_least_32_random_characters
JWT_EXPIRATION=7d
CORS_ORIGIN=http://localhost:3000

# Docker PostgreSQL
DB_USER=patapesa
DB_PASSWORD=replace_with_a_strong_password
DB_NAME=patapesa_db
DB_PORT=5432

# Frontend (must include /api)
NEXT_PUBLIC_API_URL=http://localhost:5000/api
FRONTEND_PORT=3000
API_PORT=5000

# Redis is available for future queues/caching but is not required by the API.
REDIS_PASSWORD=replace_with_a_strong_password
REDIS_PORT=6379
